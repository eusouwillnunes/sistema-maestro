        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/maestro-orquestra.py\""
          }
        ]
      },
      {
        "matcher": "Skill|Agent",
        "hooks": [
